<UserControl x:Class="CondorcetWpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Border Background="#F9FAFB" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="Backend URL" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BackendBaseUrl}" Margin="0,6,0,0" Foreground="#374151"/>
                </StackPanel>
            </Border>

            <Border Background="#F9FAFB" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                <TextBlock Text="{Binding Notes}" Foreground="#4B5563" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
