<UserControl x:Class="CondorcetWpf.Views.DfsSimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CondorcetWpf.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Load last trace" Width="130" Margin="0,0,10,0"
                    Command="{Binding LoadFromLastAnalysisCommand}"/>
            <Button Content="Prev" Width="70" Margin="0,0,6,0"
                    Command="{Binding PrevCommand}"/>
            <Button Content="Next" Width="70" Margin="0,0,6,0"
                    Command="{Binding NextCommand}"/>
            <Button Content="Reset" Width="70" Margin="0,0,12,0"
                    Command="{Binding ResetCommand}"/>
            <Button Content="{Binding PlayPauseText}" Width="90" Margin="0,0,16,0"
                    Command="{Binding PlayPauseCommand}"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="-" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#6B7280"/>
                <Slider Minimum="50" 
                        Maximum="1200" 
                        Value="{Binding SpeedMs}" 
                        IsDirectionReversed="True"
                        Width="160" 
                        Margin="5,0,5,0"
                        TickPlacement="BottomRight" 
                        TickFrequency="100"/>   
                <TextBlock Text="+" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#6B7280"/>
            </StackPanel>

            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#374151"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <Viewbox Stretch="Uniform">
                    <Grid Width="860" Height="560">
                        <Canvas Width="860" Height="560">

                            <ItemsControl ItemsSource="{Binding Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                      X2="{Binding X2}" Y2="{Binding Y2}"
                      StrokeThickness="2">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="#9CA3AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCycle}" Value="True">
                                                                <Setter Property="Stroke" Value="#EF4444"/>
                                                                <Setter Property="StrokeThickness" Value="4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Stroke" Value="#2563EB"/>
                                                                <Setter Property="StrokeThickness" Value="4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>

                                            <Polygon Points="{Binding ArrowPoints}">
                                                <Polygon.Style>
                                                    <Style TargetType="Polygon">
                                                        <Setter Property="Fill" Value="#9CA3AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCycle}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Polygon.Style>
                                            </Polygon>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-28" Y="-28"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Ellipse Width="56" Height="56">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                                        <Setter Property="Stroke" Value="#111827"/>
                                                        <Setter Property="StrokeThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="WHITE">
                                                                <Setter Property="Fill" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="GRAY">
                                                                <Setter Property="Fill" Value="#FDE68A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="BLACK">
                                                                <Setter Property="Fill" Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInStack}" Value="True">
                                                                <Setter Property="Stroke" Value="#2563EB"/>
                                                                <Setter Property="StrokeThickness" Value="4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Text="{Binding Id}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="DFS State" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StackText, StringFormat=Stack: {0}}"
                               TextWrapping="Wrap"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MessageText, StringFormat=Message: {0}}"
                               TextWrapping="Wrap"
                               Foreground="#6B7280"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Legend" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="WHITE = unvisited" Foreground="#6B7280"/>
                    <TextBlock Text="GRAY = in recursion stack" Foreground="#6B7280"/>
                    <TextBlock Text="BLACK = finished" Foreground="#6B7280"/>
                    <TextBlock Text="Blue border = on current DFS stack" Foreground="#6B7280"/>
                    <TextBlock Text="Blue edge = currently inspected" Foreground="#6B7280"/>
                    <TextBlock Text="Red edges = detected cycle" Foreground="#6B7280"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>