<Window x:Class="CondorcetWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Condorcet Analyzer" Height="820" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAV -->
        <Border Grid.Column="0" Background="#111827" Padding="16">
            <DockPanel LastChildFill="True">
                <!-- App header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Condorcet" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Analyzer Dashboard" Foreground="#C7D2FE" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Analyze"
                            Command="{Binding NavigateAnalyzeCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="DFS Simulation"
                            Command="{Binding NavigateDfsSimulationCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Artifacts"
                            Command="{Binding NavigateArtifactsCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Settings"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Separator Background="#334155"/>
                    <TextBlock Text="{Binding BackendBaseUrl}"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="Load JSON..."
                                Width="120"
                                Margin="0,0,10,0"
                                Command="{Binding LoadJsonCommand}"/>

                        <Button Content="Analyze"
                                Width="100"
                                Command="{Binding AnalyzeCommand}"
                                IsEnabled="{Binding HasInput}"/>

                        <CheckBox Content="Save artifact"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SaveArtifact}"/>

                        <CheckBox Content="Include DFS trace"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IncludeTrace}"/>

                        <TextBlock Text="Tag:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ArtifactTag}" Width="120" Margin="6,0,0,0"/>

                        <TextBlock Text="Notes:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ArtifactNotes}" Width="220" Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#374151"/>
                </DockPanel>
            </Border>

            <!-- Content presenter -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>