<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CondorcetAvalonia.ViewModels"
             x:Class="CondorcetAvalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <Grid>
    <StackPanel>
      <TextBlock Text="Dashboard"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Margin="0,0,0,14"/>

      <Border Background="#F9FAFB"
              CornerRadius="10"
              Padding="14"
              Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding Headline}"
                     FontSize="16"
                     FontWeight="SemiBold"/>

          <TextBlock Text="{Binding Subline}"
                     Margin="0,6,0,0"
                     Foreground="#4B5563"
                     TextWrapping="Wrap"/>

          <TextBlock Text="{Binding ArtifactInfo}"
                     Margin="0,10,0,0"
                     Foreground="#6B7280"/>
        </StackPanel>
      </Border>

      <Border Background="#F9FAFB"
              CornerRadius="10"
              Padding="14">
        <StackPanel>
          <TextBlock Text="Tips" FontWeight="SemiBold"/>

          <TextBlock Text="• Use Save artifact to build a reproducible dataset for future AI worker integration."
                     Margin="0,6,0,0"
                     Foreground="#4B5563"
                     TextWrapping="Wrap"/>

          <TextBlock Text="• Analyze view shows full matrices and graph."
                     Margin="0,6,0,0"
                     Foreground="#4B5563"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
