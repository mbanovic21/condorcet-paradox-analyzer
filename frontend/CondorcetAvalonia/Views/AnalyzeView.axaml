<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CondorcetAvalonia.ViewModels"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="CondorcetAvalonia.Views.AnalyzeView"
             x:DataType="vm:AnalyzeViewModel">

  <!-- Whole view scroll is not ideal; instead scroll left and right separately -->
  <Grid ColumnDefinitions="2*,3*" RowDefinitions="*"
        MinWidth="900" MinHeight="520">

    <!-- LEFT: independent vertical scroll -->
    <ScrollViewer Grid.Column="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,0,12,0">
      <StackPanel Spacing="12">

        <!-- Summary -->
        <Border Background="#EEF2FF"
                BorderBrush="#C7D2FE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding SummaryLine1}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SummaryLine2}"/>
            <TextBlock Text="{Binding CycleText}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastArtifactRunId, StringFormat=Artifact run: {0}}"
                       Margin="0,8,0,0"
                       Foreground="#6B7280"/>
          </StackPanel>
        </Border>

        <!-- Winners -->
        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Winners" FontWeight="SemiBold"/>
            <dg:DataGrid ItemsSource="{Binding WinnersRows}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         Height="180">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/>
                <dg:DataGridTextColumn Header="Winner" Binding="{Binding Winner}" Width="*"/>
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </StackPanel>
        </Border>

        <!-- Scores blocks -->
        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Scores (Borda)" FontWeight="SemiBold"/>
            <dg:DataGrid ItemsSource="{Binding BordaRows}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         Height="220">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Candidate" Binding="{Binding Candidate}" Width="*"/>
                <dg:DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120"/>
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </StackPanel>
        </Border>

        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Scores (Plurality)" FontWeight="SemiBold"/>
            <dg:DataGrid ItemsSource="{Binding PluralityRows}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         Height="220">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Candidate" Binding="{Binding Candidate}" Width="*"/>
                <dg:DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120"/>
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </StackPanel>
        </Border>

        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Scores (Copeland)" FontWeight="SemiBold"/>
            <dg:DataGrid ItemsSource="{Binding CopelandRows}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         Height="220">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Candidate" Binding="{Binding Candidate}" Width="*"/>
                <dg:DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120"/>
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </StackPanel>
        </Border>

        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Scores (Minimax / Simpson)" FontWeight="SemiBold"/>
            <dg:DataGrid ItemsSource="{Binding MinimaxRows}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         Height="220">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Candidate" Binding="{Binding Candidate}" Width="*"/>
                <dg:DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120"/>
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- RIGHT: independent vertical scroll -->
    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">

        <!-- Graph -->
        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Graph" FontWeight="SemiBold"/>
            <Border Background="White" CornerRadius="8" Padding="8">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <Image Source="{Binding GraphImage}" Stretch="Uniform"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <!-- Matrices + Trace -->
        <Border Background="#F9FAFB" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Pairwise Matrices" FontWeight="SemiBold"/>

            <TabControl>

              <TabItem Header="DFS Simulation">
                <Grid Margin="8" RowDefinitions="Auto,Auto,*">
                  <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8" Spacing="8">
                    <Button Content="⟵ Prev" Width="90" Command="{Binding TracePrevCommand}"/>
                    <Button Content="Next ⟶" Width="90" Command="{Binding TraceNextCommand}"/>
                    <Button Content="Reset" Width="90" Command="{Binding TraceResetCommand}"/>
                    <TextBlock Text="{Binding CurrentTraceIndex, StringFormat=Step: {0}}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Grid.Row="1"
                             Text="{Binding CurrentStackText, StringFormat=Stack: {0}}"
                             Foreground="#374151"
                             Margin="0,0,0,8"
                             TextWrapping="Wrap"/>

                  <ScrollViewer Grid.Row="2"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <dg:DataGrid ItemsSource="{Binding TraceRows}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True">
                      <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60"/>
                        <dg:DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                        <dg:DataGridTextColumn Header="u" Binding="{Binding U}" Width="70"/>
                        <dg:DataGridTextColumn Header="v" Binding="{Binding V}" Width="70"/>
                        <dg:DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <dg:DataGridTextColumn Header="Stack" Binding="{Binding Stack}" Width="220"/>
                      </dg:DataGrid.Columns>
                    </dg:DataGrid>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <!-- Votes matrix -->
              <TabItem Header="Votes">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid x:Name="VotesGrid"
                               ItemsSource="{Binding MatrixVotesRows}"
                               IsReadOnly="True"/>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="A (wins)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid x:Name="AGrid"
                               ItemsSource="{Binding MatrixARows}"
                               IsReadOnly="True"/>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Margin">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid x:Name="MarginGrid"
                               ItemsSource="{Binding MatrixMarginRows}"
                               IsReadOnly="True"/>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Schulze (Paths)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid x:Name="SchulzeGrid"
                               ItemsSource="{Binding MatrixSchulzeRows}"
                               IsReadOnly="True"/>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Percent">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid x:Name="PercentGrid"
                               ItemsSource="{Binding MatrixPercentRows}"
                               IsReadOnly="True"/>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Ranked Pairs">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <dg:DataGrid ItemsSource="{Binding RankedPairsRows}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Winner" Binding="{Binding Winner}" Width="*"/>
                      <dg:DataGridTextColumn Header=" " Binding="{Binding Arrow}" Width="60"/>
                      <dg:DataGridTextColumn Header="Loser" Binding="{Binding Loser}" Width="*"/>
                      <dg:DataGridTextColumn Header="Strength (N)" Binding="{Binding Strength}" Width="140"/>
                      <dg:DataGridTextColumn Header="Margin" Binding="{Binding Margin}" Width="120"/>
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </ScrollViewer>
              </TabItem>

            </TabControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
