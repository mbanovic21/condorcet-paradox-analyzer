<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CondorcetAvalonia.ViewModels"
        x:Class="CondorcetAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Condorcet Analyzer"
        Width="1200"
        Height="820"
        WindowStartupLocation="CenterScreen">

  <Grid Background="#F4F6F8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT NAV -->
    <Border Grid.Column="0" Background="#111827" Padding="16">
      <DockPanel LastChildFill="True">

        <!-- App header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Text="Condorcet" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Analyzer Dashboard" Foreground="#C7D2FE" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Nav buttons -->
        <StackPanel DockPanel.Dock="Top">
          <Button Content="Dashboard"
                  Classes="NavButton"
                  Command="{Binding NavigateDashboardCommand}"/>

          <Button Content="Analyze"
                  Classes="NavButton"
                  Command="{Binding NavigateAnalyzeCommand}"/>

          <Button Content="DFS Simulation"
                  Classes="NavButton"
                  Command="{Binding NavigateDfsSimulationCommand}"/>

          <Button Content="Artifacts"
                  Classes="NavButton"
                  Command="{Binding NavigateArtifactsCommand}"/>

          <Button Content="Settings"
                  Classes="NavButton"
                  Command="{Binding NavigateSettingsCommand}"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Separator/>
          <TextBlock Text="{Binding BackendBaseUrl}"
                     Foreground="#9CA3AF"
                     FontSize="12"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- RIGHT CONTENT -->
    <Grid Grid.Column="1" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar -->
      <Border Grid.Row="0"
              Background="#F9FAFB"
              BorderBrush="#E5E7EB"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
              Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Controls: WRAP so it works on small widths -->
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Load JSON..." Width="120" Margin="0,0,10,10" Command="{Binding LoadJsonCommand}"/>
            <Button Content="Analyze" Width="100" Margin="0,0,10,10" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding HasInput}"/>

            <CheckBox Content="Save artifact"
                      Margin="0,0,10,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding SaveArtifact}"/>

            <CheckBox Content="Include DFS trace"
                      Margin="0,0,10,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IncludeTrace}"/>

            <TextBlock Text="Tag:" VerticalAlignment="Center" Margin="8,0,6,10"/>
            <TextBox Text="{Binding ArtifactTag}" Width="120" Margin="0,0,10,10"/>

            <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="8,0,6,10"/>
            <TextBox Text="{Binding ArtifactNotes}" Width="240" Margin="0,0,10,10"/>
          </WrapPanel>

          <!-- Status always visible as its own row -->
          <Border Grid.Row="1"
                  Background="White"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}"
                      Foreground="#111827"
                      TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>


      <!-- Content presenter -->
      <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14">
        <ContentControl Content="{Binding CurrentView}"/>
      </Border>

    </Grid>
  </Grid>
</Window>
