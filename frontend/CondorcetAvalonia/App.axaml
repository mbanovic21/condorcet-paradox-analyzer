<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CondorcetAvalonia.ViewModels"
             xmlns:views="clr-namespace:CondorcetAvalonia.Views"
             x:Class="CondorcetAvalonia.App">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button.NavButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.NavButton:pointerover">
      <Setter Property="Background" Value="#1F2937"/>
    </Style>

    <Style Selector="Button.NavButton:pressed">
      <Setter Property="Background" Value="#374151"/>
    </Style>
  </Application.Styles>

  <!-- VM -> View mapping (OVO MORA OVAKO) -->
  <Application.DataTemplates>

    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>

    <DataTemplate DataType="vm:AnalyzeViewModel">
      <views:AnalyzeView/>
    </DataTemplate>

    <DataTemplate DataType="vm:DfsSimulationViewModel">
      <views:DfsSimulationView/>
    </DataTemplate>

    <DataTemplate DataType="vm:ArtifactsViewModel">
      <views:ArtifactsView/>
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>

  </Application.DataTemplates>

</Application>
